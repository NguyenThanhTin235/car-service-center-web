// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserType {
  CUSTOMER
  STAFF
}

enum EmployeePosition {
  TECHNICIAN
  DETAILER
  QC_STAFF
  ADVISOR
  OTHER
}

enum VehicleSize {
  SMALL
  MEDIUM
  LARGE
  SUV
  TRUCK
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
}

enum PricingType {
  FIXED
  VEHICLE_SIZE
  LABOUR_PARTS
}

enum InspectionTemplateType {
  INSPECTION
  QC
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  ARRIVED
  CANCELLED
}

enum IntakeType {
  WALK_IN
  TOW_IN
}

enum IntakeStatus {
  QUEUED
  CONVERTED
  CANCELLED
}

enum WorkOrderSourceType {
  APPOINTMENT
  WALK_IN
  TOW_IN
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  PENDING_PAYMENT
  RELEASED
  CLOSED
}

enum FuelLevel {
  EMPTY
  QUARTER
  HALF
  THREE_QUARTER
  FULL
}

enum CheckInStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  REJECTED
  REVISION_REQUIRED
}

enum ServiceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum InspectionStatus {
  IN_PROGRESS
  COMPLETED
}

enum InspectionResultValue {
  PASS
  FAIL
  MONITOR
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MarkerType {
  DAMAGE
  RUST
  DENT
  SCRATCH
  MISSING
  OTHER
}

enum JobStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum QuotationType {
  PRIMARY
  SUPPLEMENTARY
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

enum LineType {
  PACKAGE
  LABOUR
  PART
  MATERIAL
  FEE
}

enum QcResult {
  PASS
  FAIL
}

enum ItemType {
  PART
  CONSUMABLE
  CHEMICAL
  ACCESSORY
}

enum ReceiptType {
  PURCHASE
  OPENING_STOCK
}

enum MovementType {
  RECEIPT
  OPENING
  ISSUE
  RETURN
  ADJUSTMENT
}

enum ReferenceType {
  GOODS_RECEIPT
  JOB
  ADJUSTMENT
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BillingRequestStatus {
  PENDING
  PROCESSED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
}

enum PaymentMethod {
  CASH
  CARD
  QR_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum CatalogType {
  UOM
  CANCEL_REASON
  ADJUST_REASON
  TERMS
}

enum NotificationType {
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  CHECKIN_READY
  QUOTATION_SENT
  QUOTATION_APPROVED
  QUOTATION_REJECTED
  INVOICE_ISSUED
  PAYMENT_SUCCESS
  VEHICLE_READY
  BILLING_REQUEST
  GENERAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
}

// ==========================================
// MODELS: IDENTITY & ACCESS
// ==========================================

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique @db.VarChar(255)
  phone            String?   @unique @db.VarChar(20)
  password_hash    String    @db.VarChar(255)
  full_name        String    @db.VarChar(150)
  address          String?   @db.Text
  user_type        UserType
  is_active        Boolean   @default(true)
  otp_hash         String?   @db.VarChar(255)
  otp_attempts     Int       @default(0)
  otp_requested_at DateTime?
  otp_expires_at   DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  roles            UserRole[]
  employee         Employee?
  vehicles         Vehicle[]
  appointments     Appointment[]
  created_appointments Appointment[] @relation("CreatedAppointments")
  intake_records   IntakeRecord[]
  created_intake_records IntakeRecord[] @relation("CreatedIntakes")
  work_orders      WorkOrder[] @relation("CustomerWO")
  advisor_work_orders WorkOrder[] @relation("AdvisorWO")
  created_work_orders WorkOrder[] @relation("CreatedWO")
  check_ins        CheckIn[] @relation("CreatedCheckIn")
  confirmed_check_ins CheckIn[] @relation("ConfirmedCheckIn")
  inspections      Inspection[]
  findings         Finding[]
  jobs             Job[]
  quotations       Quotation[] @relation("CreatedQuotation")
  approved_quotations Quotation[] @relation("ApprovedQuotation")
  qc_records       QcRecord[]
  receipts         GoodsReceipt[]
  movements        StockMovement[]
  adjustments_requested StockAdjustment[] @relation("RequestedAdjustment")
  adjustments_approved StockAdjustment[] @relation("ApprovedAdjustment")
  billing_requests BillingRequest[]
  invoices         Invoice[]
  payments         Payment[]
  released_vehicles VehicleRelease[] @relation("ReleasedBy")
  confirmed_releases VehicleRelease[] @relation("ConfirmedBy")
  notifications    Notification[]
  audit_logs       AuditLog[]

  @@map("users")
}

model Role {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(50)
  description String?    @db.VarChar(255)
  
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  id      Int  @id @default(autoincrement())
  user_id Int
  role_id Int
  
  user    User @relation(fields: [user_id], references: [id])
  role    Role @relation(fields: [role_id], references: [id])

  @@unique([user_id, role_id])
  @@map("user_roles")
}

model Employee {
  id         Int              @id @default(autoincrement())
  user_id    Int?             @unique
  full_name  String           @db.VarChar(150)
  position   EmployeePosition
  is_active  Boolean          @default(true)
  created_at DateTime         @default(now())
  updated_at DateTime         @default(now()) @updatedAt

  user       User?            @relation(fields: [user_id], references: [id])
  skills     EmployeeSkill[]
  job_labours JobLabour[]

  @@map("employees")
}

model Skill {
  id        Int             @id @default(autoincrement())
  name      String          @db.VarChar(100)
  is_active Boolean         @default(true)
  
  employees EmployeeSkill[]

  @@map("skills")
}

model EmployeeSkill {
  id          Int      @id @default(autoincrement())
  employee_id Int
  skill_id    Int
  
  employee    Employee @relation(fields: [employee_id], references: [id])
  skill       Skill    @relation(fields: [skill_id], references: [id])

  @@unique([employee_id, skill_id])
  @@map("employee_skills")
}

// ==========================================
// MODELS: CUSTOMER & VEHICLE
// ==========================================

model Vehicle {
  id            Int           @id @default(autoincrement())
  customer_id   Int
  license_plate String        @unique @db.VarChar(20)
  make          String        @db.VarChar(100)
  model         String        @db.VarChar(100)
  year          Int?          @db.SmallInt
  color         String?       @db.VarChar(50)
  vehicle_size  VehicleSize
  status        VehicleStatus @default(ACTIVE)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @default(now()) @updatedAt

  customer      User          @relation(fields: [customer_id], references: [id])
  appointments  Appointment[]
  intake_records IntakeRecord[]
  work_orders   WorkOrder[]

  @@map("vehicles")
}

// ==========================================
// MODELS: SERVICE CATALOG & PRICING
// ==========================================

model ServiceCategory {
  id          Int               @id @default(autoincrement())
  name        String            @db.VarChar(100)
  description String?           @db.Text
  is_active   Boolean           @default(true)
  sort_order  Int               @default(0)
  
  templates   ServiceTemplate[]

  @@map("service_categories")
}

model ServiceTemplate {
  id             Int                 @id @default(autoincrement())
  category_id    Int
  name           String              @db.VarChar(150)
  description    String?             @db.Text
  pricing_type   PricingType
  fixed_price    Decimal?            @db.Decimal(12,2)
  is_active      Boolean             @default(true)
  created_at     DateTime            @default(now())
  updated_at     DateTime            @default(now()) @updatedAt

  category       ServiceCategory     @relation(fields: [category_id], references: [id])
  size_prices    VehicleSizePrice[]
  job_templates  JobTemplate[]
  inspection_tpls InspectionTemplate[]
  appt_services  AppointmentService[]
  wo_services    WoService[]

  @@map("service_templates")
}

model VehicleSizePrice {
  id                  Int             @id @default(autoincrement())
  service_template_id Int
  vehicle_size        VehicleSize
  price               Decimal         @db.Decimal(12,2)
  
  service_template    ServiceTemplate @relation(fields: [service_template_id], references: [id])

  @@unique([service_template_id, vehicle_size])
  @@map("vehicle_size_prices")
}

model JobType {
  id            Int           @id @default(autoincrement())
  name          String        @db.VarChar(150)
  description   String?       @db.Text
  hourly_rate   Decimal       @db.Decimal(12,2)
  is_active     Boolean       @default(true)
  
  templates     JobTemplate[]
  jobs          Job[]
  job_labours   JobLabour[]

  @@map("job_types")
}

model JobTemplate {
  id                  Int               @id @default(autoincrement())
  job_type_id         Int
  service_template_id Int?
  name                String            @db.VarChar(150)
  estimated_hours     Decimal           @db.Decimal(5,2)
  requires_qc         Boolean           @default(true)
  
  job_type            JobType           @relation(fields: [job_type_id], references: [id])
  service_template    ServiceTemplate?  @relation(fields: [service_template_id], references: [id])
  parts               JobTemplatePart[]
  jobs                Job[]

  @@map("job_templates")
}

model JobTemplatePart {
  id               Int           @id @default(autoincrement())
  job_template_id  Int
  item_id          Int
  default_quantity Decimal       @db.Decimal(10,2)
  
  job_template     JobTemplate   @relation(fields: [job_template_id], references: [id])
  item             InventoryItem @relation(fields: [item_id], references: [id])

  @@map("job_template_parts")
}

// ==========================================
// MODELS: INSPECTION & QC TEMPLATES
// ==========================================

model InspectionTemplate {
  id                  Int                      @id @default(autoincrement())
  service_template_id Int?
  template_type       InspectionTemplateType
  name                String                   @db.VarChar(150)
  is_active           Boolean                  @default(true)
  
  service_template    ServiceTemplate?         @relation(fields: [service_template_id], references: [id])
  items               InspectionTemplateItem[]
  inspections         Inspection[]
  qc_records          QcRecord[]

  @@map("inspection_templates")
}

model InspectionTemplateItem {
  id            Int                @id @default(autoincrement())
  template_id   Int
  name          String             @db.VarChar(255)
  is_required   Boolean            @default(true)
  sort_order    Int                @default(0)
  
  template      InspectionTemplate @relation(fields: [template_id], references: [id])
  results       InspectionResult[]
  qc_items      QcItem[]

  @@map("inspection_template_items")
}

// ==========================================
// MODELS: APPOINTMENT & INTAKE
// ==========================================

model Appointment {
  id             Int                 @id @default(autoincrement())
  customer_id    Int
  vehicle_id     Int
  scheduled_date DateTime            @db.Date
  scheduled_time DateTime            @db.Time
  status         AppointmentStatus   @default(REQUESTED)
  cancel_reason  String?             @db.Text
  notes          String?             @db.Text
  created_by_id  Int?
  created_at     DateTime            @default(now())
  updated_at     DateTime            @default(now()) @updatedAt

  customer       User                @relation(fields: [customer_id], references: [id])
  created_by     User?               @relation("CreatedAppointments", fields: [created_by_id], references: [id])
  vehicle        Vehicle             @relation(fields: [vehicle_id], references: [id])
  services       AppointmentService[]
  work_order     WorkOrder?

  @@map("appointments")
}

model AppointmentService {
  id                  Int             @id @default(autoincrement())
  appointment_id      Int
  service_template_id Int
  
  appointment         Appointment     @relation(fields: [appointment_id], references: [id])
  service_template    ServiceTemplate @relation(fields: [service_template_id], references: [id])

  @@map("appointment_services")
}

model IntakeRecord {
  id            Int          @id @default(autoincrement())
  customer_id   Int
  vehicle_id    Int
  intake_type   IntakeType
  status        IntakeStatus @default(QUEUED)
  arrived_at    DateTime
  tow_company   String?      @db.VarChar(255)
  notes         String?      @db.Text
  created_by_id Int
  created_at    DateTime     @default(now())

  customer      User         @relation(fields: [customer_id], references: [id])
  created_by    User         @relation("CreatedIntakes", fields: [created_by_id], references: [id])
  vehicle       Vehicle      @relation(fields: [vehicle_id], references: [id])
  work_order    WorkOrder?

  @@map("intake_records")
}

// ==========================================
// MODELS: WORK ORDER CORE
// ==========================================

model WorkOrder {
  id               Int                 @id @default(autoincrement())
  wo_number        String              @unique @db.VarChar(20)
  customer_id      Int
  vehicle_id       Int
  advisor_id       Int
  source_type      WorkOrderSourceType
  appointment_id   Int?                @unique
  intake_record_id Int?                @unique
  status           WorkOrderStatus     @default(OPEN)
  created_by_id    Int
  created_at       DateTime            @default(now())
  updated_at       DateTime            @default(now()) @updatedAt

  customer         User                @relation("CustomerWO", fields: [customer_id], references: [id])
  vehicle          Vehicle             @relation(fields: [vehicle_id], references: [id])
  advisor          User                @relation("AdvisorWO", fields: [advisor_id], references: [id])
  created_by       User                @relation("CreatedWO", fields: [created_by_id], references: [id])
  appointment      Appointment?        @relation(fields: [appointment_id], references: [id])
  intake_record    IntakeRecord?       @relation(fields: [intake_record_id], references: [id])
  
  check_in         CheckIn?
  services         WoService[]
  inspections      Inspection[]
  quotations       Quotation[]
  billing_request  BillingRequest?
  invoice          Invoice?
  release          VehicleRelease?

  @@map("work_orders")
}

model CheckIn {
  id                       Int           @id @default(autoincrement())
  work_order_id            Int           @unique
  mileage                  Int
  fuel_level               FuelLevel
  complaint                String        @db.Text
  belongings               String?       @db.Text
  exterior_condition       String        @db.Text
  status                   CheckInStatus @default(PENDING_CONFIRMATION)
  rejection_reason         String?       @db.Text
  confirmed_by_customer_id Int?
  confirmed_at             DateTime?
  evidence_urls            Json?         // Array of URLs
  created_by_id            Int
  created_at               DateTime      @default(now())
  updated_at               DateTime      @default(now()) @updatedAt

  work_order               WorkOrder     @relation(fields: [work_order_id], references: [id])
  confirmed_by             User?         @relation("ConfirmedCheckIn", fields: [confirmed_by_customer_id], references: [id])
  created_by               User          @relation("CreatedCheckIn", fields: [created_by_id], references: [id])

  @@map("check_ins")
}

model WoService {
  id                  Int              @id @default(autoincrement())
  work_order_id       Int
  service_template_id Int?
  name                String           @db.VarChar(255)
  pricing_type        PricingType
  status              ServiceStatus    @default(PENDING)
  sort_order          Int              @default(0)
  created_at          DateTime         @default(now())
  updated_at          DateTime         @default(now()) @updatedAt

  work_order          WorkOrder        @relation(fields: [work_order_id], references: [id])
  service_template    ServiceTemplate? @relation(fields: [service_template_id], references: [id])
  inspections         Inspection[]
  jobs                Job[]
  qc_records          QcRecord[]
  quotation_lines     QuotationLine[]
  invoice_lines       InvoiceLine[]

  @@map("wo_services")
}

model Inspection {
  id            Int               @id @default(autoincrement())
  work_order_id Int
  wo_service_id Int?
  template_id   Int?
  status        InspectionStatus  @default(IN_PROGRESS)
  created_by_id Int
  created_at    DateTime          @default(now())
  updated_at    DateTime          @default(now()) @updatedAt

  work_order    WorkOrder         @relation(fields: [work_order_id], references: [id])
  wo_service    WoService?        @relation(fields: [wo_service_id], references: [id])
  template      InspectionTemplate? @relation(fields: [template_id], references: [id])
  created_by    User              @relation(fields: [created_by_id], references: [id])
  results       InspectionResult[]
  findings      Finding[]

  @@map("inspections")
}

model InspectionResult {
  id               Int                    @id @default(autoincrement())
  inspection_id    Int
  template_item_id Int?
  item_name        String                 @db.VarChar(255)
  result           InspectionResultValue
  notes            String?                @db.Text

  inspection       Inspection             @relation(fields: [inspection_id], references: [id])
  template_item    InspectionTemplateItem? @relation(fields: [template_item_id], references: [id])

  @@map("inspection_results")
}

model Finding {
  id                     Int           @id @default(autoincrement())
  inspection_id          Int
  description            String        @db.Text
  severity               Severity      @default(MEDIUM)
  recommendation         String?       @db.Text
  evidence_urls          Json?
  is_visible_to_customer Boolean       @default(true)
  marker_type            MarkerType?
  part_name              String?       @db.VarChar(255)
  coordinates            Json?
  created_by_id          Int
  created_at             DateTime      @default(now())
  updated_at             DateTime      @default(now()) @updatedAt

  inspection             Inspection    @relation(fields: [inspection_id], references: [id])
  created_by             User          @relation(fields: [created_by_id], references: [id])
  job_findings           JobFinding[]

  @@map("findings")
}

model Job {
  id                       Int         @id @default(autoincrement())
  wo_service_id            Int
  job_type_id              Int?
  job_template_id          Int?
  name                     String      @db.VarChar(255)
  description              String?     @db.Text
  estimated_hours          Decimal?    @db.Decimal(5,2)
  actual_hours             Decimal?    @db.Decimal(5,2)
  status                   JobStatus   @default(PLANNED)
  result_notes             String?     @db.Text
  is_rework                Boolean     @default(false)
  parent_job_id            Int?
  rework_source_qc_item_id Int?
  created_by_id            Int
  started_at               DateTime?
  completed_at             DateTime?
  created_at               DateTime    @default(now())
  updated_at               DateTime    @default(now()) @updatedAt

  wo_service               WoService   @relation(fields: [wo_service_id], references: [id])
  job_type                 JobType?    @relation(fields: [job_type_id], references: [id])
  job_template             JobTemplate? @relation(fields: [job_template_id], references: [id])
  parent_job               Job?        @relation("ReworkJob", fields: [parent_job_id], references: [id])
  child_jobs               Job[]       @relation("ReworkJob")
  rework_qc_item           QcItem?     @relation(fields: [rework_source_qc_item_id], references: [id])
  created_by               User        @relation(fields: [created_by_id], references: [id])
  
  findings                 JobFinding[]
  labours                  JobLabour[]
  parts                    JobPart[]
  stock_movements          StockMovement[]
  quotation_lines          QuotationLine[]
  invoice_lines            InvoiceLine[]

  @@map("jobs")
}

model JobFinding {
  id         Int     @id @default(autoincrement())
  job_id     Int
  finding_id Int

  job        Job     @relation(fields: [job_id], references: [id])
  finding    Finding @relation(fields: [finding_id], references: [id])

  @@unique([job_id, finding_id])
  @@map("job_findings")
}

model JobLabour {
  id              Int       @id @default(autoincrement())
  job_id          Int
  job_type_id     Int
  description     String?   @db.Text
  employee_id     Int?
  estimated_hours Decimal   @db.Decimal(5,2)
  billable_hours  Decimal?  @db.Decimal(5,2)
  hourly_rate     Decimal   @db.Decimal(12,2)
  // amount is calculated logic: IFNULL(billable_hours, estimated_hours) * hourly_rate
  // In Prisma we usually omit generated columns or define them as raw SQL on migration
  // Let's keep it here but we'll have to manage it in DB layer
  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now()) @updatedAt

  job             Job       @relation(fields: [job_id], references: [id])
  job_type        JobType   @relation(fields: [job_type_id], references: [id])
  employee        Employee? @relation(fields: [employee_id], references: [id])
  quotation_lines QuotationLine[]

  @@map("job_labours")
}

model JobPart {
  id                Int           @id @default(autoincrement())
  job_id            Int
  item_id           Int
  planned_quantity  Decimal       @db.Decimal(10,2)
  issued_quantity   Decimal       @default(0) @db.Decimal(10,2)
  returned_quantity Decimal       @default(0) @db.Decimal(10,2)
  unit_price        Decimal       @db.Decimal(12,2)
  created_at        DateTime      @default(now())
  updated_at        DateTime      @default(now()) @updatedAt

  job               Job           @relation(fields: [job_id], references: [id])
  item              InventoryItem @relation(fields: [item_id], references: [id])
  movements         StockMovement[]
  quotation_lines   QuotationLine[]

  @@map("job_parts")
}

// ==========================================
// MODELS: QUOTATION
// ==========================================

model Quotation {
  id                  Int             @id @default(autoincrement())
  work_order_id       Int
  quotation_number    String          @unique @db.VarChar(30)
  quotation_type      QuotationType   @default(PRIMARY)
  parent_quotation_id Int?
  status              QuotationStatus @default(DRAFT)
  subtotal            Decimal         @default(0) @db.Decimal(12,2)
  discount_amount     Decimal         @default(0) @db.Decimal(12,2)
  tax_rate            Decimal         @default(0.1000) @db.Decimal(5,4)
  tax_amount          Decimal         @default(0) @db.Decimal(12,2)
  grand_total         Decimal         @default(0) @db.Decimal(12,2)
  sent_at             DateTime?
  approved_at         DateTime?
  approved_by_id      Int?
  rejected_at         DateTime?
  reject_reason       String?         @db.Text
  snapshot_at         DateTime?
  created_by_id       Int
  created_at          DateTime        @default(now())
  updated_at          DateTime        @default(now()) @updatedAt

  work_order          WorkOrder       @relation(fields: [work_order_id], references: [id])
  parent_quotation    Quotation?      @relation("QuotationSupplements", fields: [parent_quotation_id], references: [id])
  child_quotations    Quotation[]     @relation("QuotationSupplements")
  approved_by         User?           @relation("ApprovedQuotation", fields: [approved_by_id], references: [id])
  created_by          User            @relation("CreatedQuotation", fields: [created_by_id], references: [id])
  lines               QuotationLine[]

  @@map("quotations")
}

model QuotationLine {
  id                  Int          @id @default(autoincrement())
  quotation_id        Int
  line_type           LineType
  wo_service_id       Int?
  job_id              Int?
  job_labour_id       Int?
  job_part_id         Int?
  description         String       @db.VarChar(500)
  quantity            Decimal      @db.Decimal(10,2)
  snapshot_unit_price Decimal      @db.Decimal(12,2)
  amount              Decimal      @db.Decimal(12,2)
  sort_order          Int          @default(0)

  quotation           Quotation    @relation(fields: [quotation_id], references: [id])
  wo_service          WoService?   @relation(fields: [wo_service_id], references: [id])
  job                 Job?         @relation(fields: [job_id], references: [id])
  job_labour          JobLabour?   @relation(fields: [job_labour_id], references: [id])
  job_part            JobPart?     @relation(fields: [job_part_id], references: [id])
  invoice_lines       InvoiceLine[]

  @@map("quotation_lines")
}

// ==========================================
// MODELS: QC & REWORK
// ==========================================

model QcRecord {
  id             Int                 @id @default(autoincrement())
  wo_service_id  Int
  template_id    Int?
  overall_result QcResult
  notes          String?             @db.Text
  inspector_id   Int
  created_at     DateTime            @default(now())

  wo_service     WoService           @relation(fields: [wo_service_id], references: [id])
  template       InspectionTemplate? @relation(fields: [template_id], references: [id])
  inspector      User                @relation(fields: [inspector_id], references: [id])
  items          QcItem[]

  @@map("qc_records")
}

model QcItem {
  id               Int                     @id @default(autoincrement())
  qc_record_id     Int
  template_item_id Int?
  item_name        String                  @db.VarChar(255)
  result           QcResult
  notes            String?                 @db.Text

  qc_record        QcRecord                @relation(fields: [qc_record_id], references: [id])
  template_item    InspectionTemplateItem? @relation(fields: [template_item_id], references: [id])
  rework_jobs      Job[]

  @@map("qc_items")
}

// ==========================================
// MODELS: INVENTORY
// ==========================================

model Supplier {
  id             Int            @id @default(autoincrement())
  name           String         @db.VarChar(255)
  contact_person String?        @db.VarChar(150)
  phone          String?        @db.VarChar(20)
  email          String?        @db.VarChar(255)
  address        String?        @db.Text
  is_active      Boolean        @default(true)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @default(now()) @updatedAt

  receipts       GoodsReceipt[]

  @@map("suppliers")
}

model InventoryItem {
  id            Int                @id @default(autoincrement())
  sku           String             @unique @db.VarChar(50)
  name          String             @db.VarChar(255)
  item_type     ItemType
  uom_id        Int
  selling_price Decimal            @db.Decimal(12,2)
  average_cost  Decimal            @default(0) @db.Decimal(12,4)
  on_hand       Decimal            @default(0) @db.Decimal(10,2)
  reorder_level Decimal            @default(0) @db.Decimal(10,2)
  is_active     Boolean            @default(true)
  created_at    DateTime           @default(now())
  updated_at    DateTime           @default(now()) @updatedAt

  uom           SystemCatalog      @relation(fields: [uom_id], references: [id])
  job_template_parts JobTemplatePart[]
  job_parts     JobPart[]
  receipt_items GoodsReceiptItem[]
  movements     StockMovement[]
  adjustments   StockAdjustment[]

  @@map("inventory_items")
}

model GoodsReceipt {
  id             Int                @id @default(autoincrement())
  receipt_number String             @unique @db.VarChar(30)
  supplier_id    Int?
  receipt_type   ReceiptType
  reference_no   String?            @db.VarChar(100)
  received_date  DateTime           @db.Date
  notes          String?            @db.Text
  created_by_id  Int
  created_at     DateTime           @default(now())

  supplier       Supplier?          @relation(fields: [supplier_id], references: [id])
  created_by     User               @relation(fields: [created_by_id], references: [id])
  items          GoodsReceiptItem[]

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id         Int           @id @default(autoincrement())
  receipt_id Int
  item_id    Int
  quantity   Decimal       @db.Decimal(10,2)
  unit_cost  Decimal       @db.Decimal(12,4)

  receipt    GoodsReceipt  @relation(fields: [receipt_id], references: [id])
  item       InventoryItem @relation(fields: [item_id], references: [id])

  @@map("goods_receipt_items")
}

model StockMovement {
  id                 Int           @id @default(autoincrement())
  item_id            Int
  movement_type      MovementType
  reference_type     ReferenceType
  reference_id       Int
  source_movement_id Int?
  job_id             Int?
  job_part_id        Int?
  quantity           Decimal       @db.Decimal(10,2)
  unit_cost          Decimal       @db.Decimal(12,4)
  balance_after      Decimal       @db.Decimal(10,2)
  notes              String?       @db.Text
  created_by_id      Int
  created_at         DateTime      @default(now())

  item               InventoryItem @relation(fields: [item_id], references: [id])
  source_movement    StockMovement? @relation("MovementLink", fields: [source_movement_id], references: [id])
  child_movements    StockMovement[] @relation("MovementLink")
  job                Job?          @relation(fields: [job_id], references: [id])
  job_part           JobPart?      @relation(fields: [job_part_id], references: [id])
  created_by         User          @relation(fields: [created_by_id], references: [id])

  @@map("stock_movements")
}

model StockAdjustment {
  id                  Int              @id @default(autoincrement())
  item_id             Int
  adjustment_quantity Decimal          @db.Decimal(10,2)
  reason              String           @db.Text
  status              AdjustmentStatus @default(PENDING)
  requested_by_id     Int
  approved_by_id      Int?
  approved_at         DateTime?
  reject_reason       String?          @db.Text
  created_at          DateTime         @default(now())

  item                InventoryItem    @relation(fields: [item_id], references: [id])
  requested_by        User             @relation("RequestedAdjustment", fields: [requested_by_id], references: [id])
  approved_by         User?            @relation("ApprovedAdjustment", fields: [approved_by_id], references: [id])

  @@map("stock_adjustments")
}

// ==========================================
// MODELS: BILLING & PAYMENT
// ==========================================

model BillingRequest {
  id              Int                  @id @default(autoincrement())
  work_order_id   Int                  @unique
  status          BillingRequestStatus @default(PENDING)
  requested_by_id Int
  created_at      DateTime             @default(now())

  work_order      WorkOrder            @relation(fields: [work_order_id], references: [id])
  requested_by    User                 @relation(fields: [requested_by_id], references: [id])

  @@map("billing_requests")
}

model Invoice {
  id              Int           @id @default(autoincrement())
  work_order_id   Int           @unique
  invoice_number  String        @unique @db.VarChar(30)
  status          InvoiceStatus @default(DRAFT)
  subtotal        Decimal       @db.Decimal(12,2)
  discount_amount Decimal       @default(0) @db.Decimal(12,2)
  tax_amount      Decimal       @default(0) @db.Decimal(12,2)
  total_amount    Decimal       @db.Decimal(12,2)
  amount_due      Decimal       @db.Decimal(12,2)
  issued_at       DateTime?
  created_by_id   Int
  created_at      DateTime      @default(now())
  updated_at      DateTime      @default(now()) @updatedAt

  work_order      WorkOrder     @relation(fields: [work_order_id], references: [id])
  created_by      User          @relation(fields: [created_by_id], references: [id])
  lines           InvoiceLine[]
  payments        Payment[]

  @@map("invoices")
}

model InvoiceLine {
  id                Int            @id @default(autoincrement())
  invoice_id        Int
  line_type         LineType
  quotation_line_id Int?
  wo_service_id     Int?
  job_id            Int?
  description       String         @db.VarChar(500)
  quantity          Decimal        @db.Decimal(10,2)
  unit_price        Decimal        @db.Decimal(12,2)
  amount            Decimal        @db.Decimal(12,2)
  sort_order        Int            @default(0)

  invoice           Invoice        @relation(fields: [invoice_id], references: [id])
  quotation_line    QuotationLine? @relation(fields: [quotation_line_id], references: [id])
  wo_service        WoService?     @relation(fields: [wo_service_id], references: [id])
  job               Job?           @relation(fields: [job_id], references: [id])

  @@map("invoice_lines")
}

model Payment {
  id               Int           @id @default(autoincrement())
  invoice_id       Int
  payment_method   PaymentMethod
  amount           Decimal       @db.Decimal(12,2)
  transaction_ref  String?       @unique @db.VarChar(255)
  gateway_provider String?       @db.VarChar(50)
  payment_payload  Json?
  status           PaymentStatus @default(PENDING)
  paid_at          DateTime?
  received_by_id   Int?
  created_at       DateTime      @default(now())

  invoice          Invoice       @relation(fields: [invoice_id], references: [id])
  received_by      User?         @relation(fields: [received_by_id], references: [id])

  @@map("payments")
}

model VehicleRelease {
  id                       Int       @id @default(autoincrement())
  work_order_id            Int       @unique
  release_notes            String?   @db.Text
  released_by_id           Int
  released_at              DateTime
  confirmed_by_customer_id Int?
  confirmed_at             DateTime?

  work_order               WorkOrder @relation(fields: [work_order_id], references: [id])
  released_by              User      @relation("ReleasedBy", fields: [released_by_id], references: [id])
  confirmed_by             User?     @relation("ConfirmedBy", fields: [confirmed_by_customer_id], references: [id])

  @@map("vehicle_releases")
}

// ==========================================
// MODELS: SYSTEM & SUPPORT
// ==========================================

model SystemCatalog {
  id          Int         @id @default(autoincrement())
  catalog_type CatalogType
  name        String      @db.VarChar(150)
  description String?     @db.Text
  is_active   Boolean     @default(true)
  sort_order  Int         @default(0)

  items       InventoryItem[]

  @@unique([catalog_type, name])
  @@map("system_catalogs")
}

model Notification {
  id                Int              @id @default(autoincrement())
  user_id           Int
  notification_type NotificationType
  title             String           @db.VarChar(255)
  message           String           @db.Text
  entity_type       String?          @db.VarChar(50)
  entity_id         Int?
  is_read           Boolean          @default(false)
  read_at           DateTime?
  created_at        DateTime         @default(now())

  user              User             @relation(fields: [user_id], references: [id])

  @@map("notifications")
}

model AuditLog {
  id          Int         @id @default(autoincrement())
  user_id     Int?
  action      AuditAction
  entity_type String      @db.VarChar(50)
  entity_id   Int
  before_data Json?
  after_data  Json?
  ip_address  String?     @db.VarChar(45)
  user_agent  String?     @db.VarChar(500)
  created_at  DateTime    @default(now())

  user        User?       @relation(fields: [user_id], references: [id])

  @@map("audit_logs")
}
