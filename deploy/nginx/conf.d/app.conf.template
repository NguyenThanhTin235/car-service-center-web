# Production upstreams (host loopback via host.docker.internal)
upstream prod_api_upstream {
    server host.docker.internal:5000;
}

upstream prod_customer_upstream {
    server host.docker.internal:3000;
}

upstream prod_admin_upstream {
    server host.docker.internal:3001;
}

# Staging upstreams (host loopback via host.docker.internal)
upstream staging_api_upstream {
    server host.docker.internal:5100;
}

upstream staging_customer_upstream {
    server host.docker.internal:3100;
}

upstream staging_admin_upstream {
    server host.docker.internal:3101;
}

# HTTP: ACME challenge + HTTPS redirect for all 6 hostnames
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN_NAME} api.${DOMAIN_NAME} ops.${DOMAIN_NAME} staging.${DOMAIN_NAME} staging-api.${DOMAIN_NAME} staging-ops.${DOMAIN_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- Production HTTPS ---
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.${DOMAIN_NAME};

    ssl_certificate /etc/letsencrypt/live/${CERT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location /socket.io/ {
        proxy_pass http://prod_api_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location / {
        proxy_pass http://prod_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}

