PORT=5000
FRONTEND_URL=http://localhost:3000

# Prisma / Database
DATABASE_URL="mysql://root:password@localhost:3306/car_service_center"

# JWT
JWT_SECRET=your_super_secret_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# Gmail SMTP (dùng App Password, không phải mật khẩu Gmail thông thường)
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Cloudinary
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gemini AI (Multiple keys supported for automatic fallback)
GEMINI_API_KEY_1=your_gemini_key_1
GEMINI_API_KEY_2=your_gemini_key_2
GEMINI_API_KEY_3=your_gemini_key_3
GEMINI_API_KEY_4=your_gemini_key_4
GEMINI_API_KEYS=your_key_1,your_key_2
GEMINI_MODEL=gemini-3.8-flash

