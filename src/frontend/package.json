{
  "name": "car-service-center-frontend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:customer\" \"npm run dev:internal\"",
    "dev:customer": "npm run dev -w @car-service-center/customer-web",
    "dev:internal": "npm run dev -w @car-service-center/internal-web",
    "build": "npm run build --workspaces",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "install:all": "npm install"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.0.0",
    "concurrently": "^10.0.5"
  }
}
