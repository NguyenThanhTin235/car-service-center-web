{
  "name": "car-service-center-frontend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/shared/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:customer\" \"npm run dev:internal\"",
    "dev:customer": "npm run dev -w @car-service-center/customer-web",
    "dev:internal": "npm run dev -w @car-service-center/internal-web",
    "build": "npm run build --workspaces --if-present",
    "test:unit": "npm run test:unit:customer && npm run test:unit:internal",
    "test:unit:customer": "node --test apps/customer-web/tests/unit/*.test.ts",
    "test:unit:internal": "npm run test:unit -w @car-service-center/internal-web",
    "test:e2e:customer": "playwright test customer-",
    "test:customer": "npm run test:unit:customer && npm run test:e2e:customer",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "npm run lint --workspaces --if-present",
    "install:all": "npm install"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.0.0",
    "concurrently": "^10.0.5"
  }
}
